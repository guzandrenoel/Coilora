{
  "name": "coilora",
  "version": "0.1.0",
  "private": true,
  "description": "A source-grounded study workspace for medical and allied-health students.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @coilora/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @coilora/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "supabase": "^2.116.0"
  }
}
