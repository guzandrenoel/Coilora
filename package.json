{
  "name": "coilora",
  "version": "0.1.0",
  "private": true,
  "description": "A source-grounded study workspace for medical and allied-health students.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @coilora/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @coilora/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "supabase": "^2.116.0"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
